# Copy this file and name the copy ".env" (dot env, no other name).
# Then paste your own key after the = sign. Never share your .env file.
# If you leave GEMINI_API_KEY empty, everything still works in MOCK mode
# (a pretend AI that gives simple offline answers), so you can always keep learning.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
