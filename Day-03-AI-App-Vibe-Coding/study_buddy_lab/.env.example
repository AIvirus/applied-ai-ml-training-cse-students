# Copy this file to ".env" and fill in your own values. Never upload .env to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# true = always use the pretend AI (no key needed, no cost)
MOCK_MODE=false

# Biggest upload allowed, in megabytes
MAX_UPLOAD_MB=2

# How much to log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
